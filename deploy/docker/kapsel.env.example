# Container environment for docker compose. Copy this file to
# deploy/docker/kapsel.env and replace all example secrets before use.
#
# The image publishes Kapsel on 0.0.0.0:8080 inside the container (see
# KAPSEL_ADDR in docker-compose.yml) and docker-compose.yml forwards host
# port 8080 to it. Binding outside loopback REQUIRES authentication; never run
# with KAPSEL_AUTH_MODE=disabled on a network you do not fully trust.

# --- Storage --------------------------------------------------------------
# These paths are the named volumes in docker-compose.yml. Downloads land in
# /media and survive container recreation.
KAPSEL_DATA_DIR=/data
KAPSEL_DB_PATH=/data/kapsel.db
KAPSEL_MEDIA_ROOT=/media
KAPSEL_IMPORT_ROOT=/imports

# --- Media URL signing ----------------------------------------------------
KAPSEL_MEDIA_SIGNING_SECRET=replace-with-random-media-signing-secret
KAPSEL_MEDIA_URL_TTL=1h
KAPSEL_MIN_FREE_SPACE=1GiB

# --- Auth (REQUIRED when binding 0.0.0.0) ---------------------------------
KAPSEL_AUTH_MODE=required
KAPSEL_AUTH_USERNAME=admin
# Generate with:  docker compose run --rm kapsel hash-password
KAPSEL_AUTH_PASSWORD_HASH=replace-with-output-from-kapsel-hash-password
KAPSEL_SESSION_SECRET=replace-with-random-session-secret
KAPSEL_SESSION_TTL=168h
# Set true when HTTPS terminates in front of Kapsel (reverse proxy or
# self-signed). Leave false for plain HTTP on a trusted LAN.
KAPSEL_SESSION_COOKIE_SECURE=false

# --- Media tools (bundled in the image) -----------------------------------
# /usr/local/bin/kapsel-ytdlp wraps the bundled nightly yt-dlp and selects
# Deno for JS challenges. The image auto-updates yt-dlp every 24h (set 0s to
# disable). ffmpeg comes from the debian base image.
KAPSEL_YTDLP_PATH=/usr/local/bin/kapsel-ytdlp
KAPSEL_YTDLP_FORMAT=bv[height<=1080][ext=mp4][vcodec^=avc1][acodec=none]+ba[ext=m4a][acodec^=mp4a]/b[height<=1080][ext=mp4][vcodec^=avc1][acodec^=mp4a]/b[height<=1080][ext=mp4]/best[height<=1080]
# Optional Netscape cookies.txt for authenticated yt-dlp requests. Mount it as
# a file (e.g. ./youtube.cookies.txt:/etc/kapsel/youtube.cookies.txt:ro) and
# point KAPSEL_YTDLP_COOKIES_FILE at the container path. Treat it like a
# password; keep it out of the repo.
# KAPSEL_YTDLP_COOKIES_FILE=/etc/kapsel/youtube.cookies.txt
# Randomized by roughly +/- 50% between consecutive yt-dlp calls. Set 0s only
# for trusted local testing.
KAPSEL_YTDLP_SLEEP_INTERVAL=10s
KAPSEL_YTDLP_UPDATE_INTERVAL=24h
KAPSEL_FFMPEG_PATH=/usr/bin/ffmpeg
# Download video subtitles during downloads. Set false to skip subtitle fetching
# entirely (useful when YouTube rate-limits the subtitle endpoint with HTTP 429).
# KAPSEL_SUBTITLES_ENABLED=true
# Minimum time between automatic checks of subscribed channels for new episodes.
# Set to a shorter duration (e.g. 6h) for a faster cycle, or 0s to disable the
# auto-download scheduler entirely. Per-channel checks are spaced with random
# jitter based on each channel's last scan time, so many channels do not fire at once.
# KAPSEL_CHANNEL_AUTO_DOWNLOAD_INTERVAL=24h
# Leave unset to auto-enable previews when ffmpeg is available. Set false to
# disable explicitly.
# KAPSEL_PREVIEWS_ENABLED=false
# SponsorBlock sponsor skipping is enabled by default. Set false to disable
# external segment lookups.
# KAPSEL_SPONSORBLOCK_ENABLED=false
