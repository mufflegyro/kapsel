# Copy to /etc/kapsel/kapsel.env or another service-specific env file.
# Replace all example secrets before using auth outside local development.

KAPSEL_ADDR=127.0.0.1:8080
KAPSEL_DATA_DIR=/var/lib/kapsel
KAPSEL_DB_PATH=/var/lib/kapsel/kapsel.db
KAPSEL_MEDIA_ROOT=/srv/kapsel/media
KAPSEL_IMPORT_ROOT=/srv/kapsel/imports

KAPSEL_MEDIA_SIGNING_SECRET=replace-with-random-media-signing-secret
KAPSEL_MEDIA_URL_TTL=1h
KAPSEL_MIN_FREE_SPACE=1GiB

KAPSEL_AUTH_MODE=required
KAPSEL_AUTH_USERNAME=admin
KAPSEL_AUTH_PASSWORD_HASH=replace-with-output-from-kapsel-hash-password
KAPSEL_SESSION_SECRET=replace-with-random-session-secret
KAPSEL_SESSION_TTL=168h
KAPSEL_SESSION_COOKIE_SECURE=false

KAPSEL_YTDLP_PATH=yt-dlp
KAPSEL_YTDLP_FORMAT=bv[height<=1080][ext=mp4][vcodec^=avc1][acodec=none]+ba[ext=m4a][acodec^=mp4a]/b[height<=1080][ext=mp4][vcodec^=avc1][acodec^=mp4a]/b[height<=1080][ext=mp4]/best[height<=1080]
# Optional Netscape cookies.txt file for authenticated yt-dlp requests.
# Fixes YouTube's "Sign in to confirm you're not a bot" block; export from
# your browser with scripts/export-cookies.sh. Treat this file like a password.
# Pacing still applies when cookies are configured to avoid rapid repeated
# YouTube requests.
# KAPSEL_YTDLP_COOKIES_FILE=/etc/kapsel/youtube.cookies.txt
# Randomized by roughly +/- 50% between consecutive yt-dlp calls. Set to 0s only for trusted local testing.
KAPSEL_YTDLP_SLEEP_INTERVAL=10s
# How often to auto-update the bundled yt-dlp binary to the latest nightly.
# Keeps downloads working as YouTube changes its player and format handling.
KAPSEL_YTDLP_UPDATE_INTERVAL=24h
KAPSEL_FFMPEG_PATH=ffmpeg
# Download video subtitles during downloads. Set false to skip subtitle fetching
# entirely (useful when YouTube rate-limits the subtitle endpoint with HTTP 429).
# KAPSEL_SUBTITLES_ENABLED=true
# Minimum time between automatic checks of subscribed channels for new episodes.
# Set to a shorter duration (e.g. 6h) for a faster cycle, or 0s to disable the
# auto-download scheduler entirely. Per-channel checks are spaced with random
# jitter based on each channel's last scan time, so many channels do not fire at once.
# KAPSEL_CHANNEL_AUTO_DOWNLOAD_INTERVAL=24h
# How long after a video is marked watched before its media file is removed at
# the next daily retention run. Applies to every origin (channel auto-downloads,
# manual downloads, imports); "Keep forever" always protects a video. Set 0s to
# disable watched-media cleanup entirely.
# KAPSEL_RETENTION_WATCHED_AFTER=24h
# Leave unset to auto-enable previews when ffmpeg is available. Set false to disable explicitly.
# KAPSEL_PREVIEWS_ENABLED=false
# GitHub owner/name repository checked for new kapsel releases. Discovered
# updates appear in Settings > Updates and are installed only after an admin
# approves them there. Before applying, kapsel verifies the release checksum
# and writes a full database backup into the data dir's backups/ folder.
# KAPSEL_UPDATE_REPO=mufflegyro/yummle
# How often kapsel checks GitHub for a new release. Set 0s to disable the
# scheduled check entirely (manual "Check now" in Settings still works).
# KAPSEL_UPDATE_CHECK_INTERVAL=24h
# SponsorBlock sponsor skipping is enabled by default. Set false to disable external segment lookups.
# KAPSEL_SPONSORBLOCK_ENABLED=false
